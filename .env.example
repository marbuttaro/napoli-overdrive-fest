# Dashboard /admin — credenziali fisse
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Firma dei cookie di sessione: stringa casuale lunga (es. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# Vercel Blob (dove vengono salvati i loghi) — in locale: `vercel env pull` lo scrive in .env.local
BLOB_READ_WRITE_TOKEN=
